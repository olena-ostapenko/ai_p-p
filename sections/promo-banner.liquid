{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.color_scheme.settings.background }};
    color: {{ section.settings.color_scheme.settings.text }};
  }

  .promo-banner-{{ section.id }} .promo-banner__container {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: {{ section.settings.section_padding_top }}px {{ section.settings.section_padding_horizontal }}px {{ section.settings.section_padding_bottom }}px;
  }

  .promo-banner-{{ section.id }} .promo-banner__grid {
    display: flex;
    flex-direction: {% if section.settings.image_position == 'left' %}row{% else %}row-reverse{% endif %};
    align-items: center;
    gap: {{ section.settings.columns_gap }}px;
  }

  .promo-banner-{{ section.id }} .promo-banner__text-col {
    flex: 1;
    min-width: 0;
  }

  .promo-banner-{{ section.id }} .promo-banner__image-col {
    flex: 0 0 auto;
    width: {{ section.settings.image_width }}px;
    max-width: 100%;
  }

  .promo-banner-{{ section.id }} .promo-banner__title {
    margin-bottom: {{ section.settings.title_margin_bottom }}px;
  }

  .promo-banner-{{ section.id }} .promo-banner__subtitle {
    margin-bottom: {{ section.settings.subtitle_margin_bottom }}px;
  }

  .promo-banner-{{ section.id }} .promo-banner__subtitle strong {
    color: {{ section.settings.accent_color }};
  }

  .promo-banner-{{ section.id }} .promo-banner__description {
    margin-bottom: {{ section.settings.description_margin_bottom }}px;
  }

  .promo-banner-{{ section.id }} .promo-banner__image-wrapper {
    position: relative;
    display: block;
    width: 100%;
  }

  .promo-banner-{{ section.id }} .promo-banner__image-wrapper::after {
    content: '';
    position: absolute;
    inset: -0.5rem;
    border: {{ section.settings.border_thickness }}px solid {{ section.settings.decoration_color }};
    border-radius: {{ section.settings.decoration_border_radius }}px;
    pointer-events: none;
  }

  .promo-banner-{{ section.id }} .promo-banner__image img {
    width: {{ section.settings.image_width }}px;
    max-width: 100%;
    height: auto;
    display: block;
    border-radius: {% if section.settings.image_border_radius %}{{ section.settings.image_border_radius_px }}px{% else %}0{% endif %};
  }

  .promo-banner-{{ section.id }} .promo-banner__button {
    display: inline-block;
    background-color: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    padding: {{ section.settings.button_padding_vertical }}px {{ section.settings.button_padding_horizontal }}px;
    border-radius: {{ section.settings.button_border_radius }}px;
    text-decoration: none;
    font-weight: 600;
    transition: opacity 0.2s ease;
  }

  .promo-banner-{{ section.id }} .promo-banner__button:hover {
    opacity: 0.85;
  }

  @media screen and (max-width: 749px) {
    .promo-banner-{{ section.id }} .promo-banner__container {
      padding-top: {{ section.settings.section_padding_top_mobile }}px;
      padding-bottom: {{ section.settings.section_padding_bottom_mobile }}px;
      padding-left: {{ section.settings.section_padding_horizontal_mobile }}px;
      padding-right: {{ section.settings.section_padding_horizontal_mobile }}px;
    }

    .promo-banner-{{ section.id }} .promo-banner__grid {
      flex-direction: column;
      gap: {{ section.settings.columns_gap_mobile }}px;
      align-items: center;
    }

    .promo-banner-{{ section.id }} .promo-banner__text-col {
      width: 100%;
      text-align: center;
    }

    .promo-banner-{{ section.id }} .promo-banner__image-col {
      width: {{ section.settings.image_width_mobile }}px;
      max-width: 100%;
      margin: 0 auto;
      flex: 0 0 auto;
    }

    .promo-banner-{{ section.id }} .promo-banner__image img {
      width: 100%;
      height: auto;
      display: block;
    }

    .promo-banner-{{ section.id }} .promo-banner__title {
      margin-bottom: {{ section.settings.title_margin_bottom_mobile }}px;
    }

    .promo-banner-{{ section.id }} .promo-banner__subtitle {
      margin-bottom: {{ section.settings.subtitle_margin_bottom_mobile }}px;
    }

    .promo-banner-{{ section.id }} .promo-banner__description {
      margin-bottom: {{ section.settings.description_margin_bottom_mobile }}px;
    }
  }
{%- endstyle -%}

<div class="promo-banner-{{ section.id }}">
  <div class="promo-banner__container">
    <div class="promo-banner__grid page-width">

      {%- comment -%} Text Column {%- endcomment -%}
      <div class="promo-banner__text-col">
        {%- if section.settings.title != blank -%}
          <div class="promo-banner__title">
            {{ section.settings.title }}
          </div>
        {%- endif -%}

        {%- if section.settings.subtitle != blank -%}
          <div class="promo-banner__subtitle">
            {{ section.settings.subtitle }}
          </div>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="promo-banner__description">
            {{ section.settings.description }}
          </div>
        {%- endif -%}

        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <a
            href="{{ section.settings.button_link }}"
            class="promo-banner__button"
            {% if section.settings.button_open_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
          >
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>

      {%- comment -%} Image Column {%- endcomment -%}
      <div class="promo-banner__image-col">
        <div class="promo-banner__image-wrapper">
          <div class="promo-banner__image">
            {%- if section.settings.image != blank -%}
              {%- capture image_sizes -%}
                (max-width: 749px) {{ section.settings.image_width_mobile }}px, {{ section.settings.image_width }}px
              {%- endcapture -%}
              {{ section.settings.image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  widths: '300, 400, 500, 600, 800, 1000, 1200',
                  sizes: image_sizes,
                  alt: section.settings.image.alt | escape
              }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Promo Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Color Scheme"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "right", "label": "Text left, Image right" },
        { "value": "left",  "label": "Image left, Text right" }
      ],
      "default": "right"
    },
    {
      "type": "range",
      "id": "columns_gap",
      "label": "Gap between columns (desktop)",
      "min": 0, "max": 120, "step": 4, "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "columns_gap_mobile",
      "label": "Gap between columns (mobile)",
      "min": 0, "max": 80, "step": 4, "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Section Padding (Desktop)"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Padding top",
      "min": 0, "max": 120, "step": 4, "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Padding bottom",
      "min": 0, "max": 120, "step": 4, "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "section_padding_horizontal",
      "label": "Padding horizontal",
      "min": 0, "max": 80, "step": 4, "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Section Padding (Mobile)"
    },
    {
      "type": "range",
      "id": "section_padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0, "max": 80, "step": 4, "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "section_padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0, "max": 80, "step": 4, "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "section_padding_horizontal_mobile",
      "label": "Padding horizontal (mobile)",
      "min": 0, "max": 40, "step": 4, "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Title",
      "default": "<p><strong>CUSTOM SHAPED PILLOWS</strong></p>"
    },
    {
      "type": "range",
      "id": "title_margin_bottom",
      "label": "Title margin bottom (desktop)",
      "min": 0, "max": 80, "step": 2, "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "title_margin_bottom_mobile",
      "label": "Title margin bottom (mobile)",
      "min": 0, "max": 60, "step": 2, "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Subtitle"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "<p>Turn Your Pet Into <strong>A One-Of-A-Kind Pillow</strong> Made Just For You</p>"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Subtitle accent color (bold text)",
      "default": "#E9A753"
    },
    {
      "type": "range",
      "id": "subtitle_margin_bottom",
      "label": "Subtitle margin bottom (desktop)",
      "min": 0, "max": 80, "step": 2, "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "subtitle_margin_bottom_mobile",
      "label": "Subtitle margin bottom (mobile)",
      "min": 0, "max": 60, "step": 2, "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Description"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Soft, cozy, and completely personalized — our custom-shaped pillows are designed to capture your pet's unique look and personality.</p>"
    },
    {
      "type": "range",
      "id": "description_margin_bottom",
      "label": "Description margin bottom (desktop)",
      "min": 0, "max": 80, "step": 2, "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "description_margin_bottom_mobile",
      "label": "Description margin bottom (mobile)",
      "min": 0, "max": 60, "step": 2, "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Create Yours"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "button_open_new_tab",
      "label": "Open link in new tab",
      "default": false
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background color",
      "default": "#E9A753"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "button_padding_vertical",
      "label": "Button padding vertical",
      "min": 4, "max": 32, "step": 2, "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_padding_horizontal",
      "label": "Button padding horizontal",
      "min": 8, "max": 80, "step": 2, "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Button border radius",
      "min": 0, "max": 50, "step": 1, "unit": "px",
      "default": 30
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Image width (desktop)",
      "min": 100, "max": 900, "step": 10, "unit": "px",
      "default": 500
    },
    {
      "type": "range",
      "id": "image_width_mobile",
      "label": "Image width (mobile)",
      "min": 100, "max": 500, "step": 10, "unit": "px",
      "default": 300
    },
    {
      "type": "checkbox",
      "id": "image_border_radius",
      "label": "Enable image border radius",
      "default": true
    },
    {
      "type": "range",
      "id": "image_border_radius_px",
      "label": "Image border radius",
      "min": 0, "max": 80, "step": 2, "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Border Decoration"
    },
    {
      "type": "color",
      "id": "decoration_color",
      "label": "Border color",
      "default": "#C89A2A"
    },
    {
      "type": "range",
      "id": "border_thickness",
      "label": "Border thickness",
      "min": 1, "max": 20, "step": 1, "unit": "px",
      "default": 3
    },
    {
      "type": "range",
      "id": "decoration_border_radius",
      "label": "Border radius",
      "min": 0, "max": 80, "step": 2, "unit": "px",
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Promo Banner"
    }
  ]
}
{% endschema %}
