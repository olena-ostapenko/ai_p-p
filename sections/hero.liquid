{{ 'hero-banner.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.color_scheme.settings.background }};
    color: {{ section.settings.color_scheme.settings.text }};
  }

  .hero-banner-{{ section.id }} .hero-banner__container {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: {{ section.settings.section_padding_top }}px {{ section.settings.section_padding_horizontal }}px {{ section.settings.section_padding_bottom }}px;
  }

  .hero-banner-{{ section.id }} .hero-banner__grid {
    display: flex;
    flex-direction: {% if section.settings.image_position == 'left' %}row{% else %}row-reverse{% endif %};
    align-items: center;
    gap: {{ section.settings.columns_gap }}px;
  }

  .hero-banner-{{ section.id }} .hero-banner__text-col,
  .hero-banner-{{ section.id }} .hero-banner__image-col {
    flex: 1;
    min-width: 0;
  }

  .hero-banner-{{ section.id }} .hero-banner__title {
    margin-bottom: {{ section.settings.title_margin_bottom }}px;
  }

  .hero-banner-{{ section.id }} .hero-banner__subtitle {
    margin-bottom: {{ section.settings.subtitle_margin_bottom }}px;
  }

  .hero-banner-{{ section.id }} .hero-banner__description {
    margin-bottom: {{ section.settings.description_margin_bottom }}px;
  }

  .hero-banner-{{ section.id }} .hero-banner__image img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {% if section.settings.image_border_radius %}{{ section.settings.image_border_radius_px }}px{% else %}0{% endif %};
  }

  {%- if section.settings.image_decoration == 'rectangle' -%}
  .hero-banner-{{ section.id }} .hero-banner__image-wrapper {
    position: relative;
    display: inline-block;
    width: 100%;
  }
  .hero-banner-{{ section.id }} .hero-banner__image-wrapper::after {
    content: '';
    display: block;
    margin-top: {{ section.settings.decoration_offset }}px;
    width: {{ section.settings.decoration_width }}px;
    height: {{ section.settings.decoration_height }}px;
    background-color: {{ section.settings.decoration_color }};
    border-radius: {{ section.settings.decoration_border_radius }}px;
  }
  {%- elsif section.settings.image_decoration == 'border' -%}
  .hero-banner-{{ section.id }} .hero-banner__image-wrapper {
    position: relative;
    display: block;
    width: 100%;
  }
  .hero-banner-{{ section.id }} .hero-banner__image-wrapper::after {
    content: '';
    position: absolute;
    inset: {{ section.settings.border_offset }}px;
    border: {{ section.settings.decoration_width }}px solid {{ section.settings.decoration_color }};
    border-radius: {{ section.settings.decoration_border_radius }}px;
    pointer-events: none;
  }
  {%- else -%}
  .hero-banner-{{ section.id }} .hero-banner__image-wrapper {
    display: block;
    width: 100%;
  }
  {%- endif -%}

  .hero-banner-{{ section.id }} .hero-banner__button {
    display: inline-block;
    background-color: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    padding: {{ section.settings.button_padding_vertical }}px {{ section.settings.button_padding_horizontal }}px;
    border-radius: {{ section.settings.button_border_radius }}px;
    text-decoration: none;
    font-weight: 600;
    transition: opacity 0.2s ease;
  }

  .hero-banner-{{ section.id }} .hero-banner__button:hover {
    opacity: 0.85;
  }

  @media screen and (max-width: 749px) {
    .hero-banner-{{ section.id }} .hero-banner__container {
      padding-top: {{ section.settings.section_padding_top_mobile }}px;
      padding-bottom: {{ section.settings.section_padding_bottom_mobile }}px;
      padding-left: {{ section.settings.section_padding_horizontal_mobile }}px;
      padding-right: {{ section.settings.section_padding_horizontal_mobile }}px;
    }

    .hero-banner-{{ section.id }} .hero-banner__grid {
      flex-direction: column;
      gap: {{ section.settings.columns_gap_mobile }}px;
    }

    .hero-banner-{{ section.id }} .hero-banner__text-col,
    .hero-banner-{{ section.id }} .hero-banner__image-col {
      width: 100%;
    }

    .hero-banner-{{ section.id }} .hero-banner__title {
      margin-bottom: {{ section.settings.title_margin_bottom_mobile }}px;
    }

    .hero-banner-{{ section.id }} .hero-banner__subtitle {
      margin-bottom: {{ section.settings.subtitle_margin_bottom_mobile }}px;
    }

    .hero-banner-{{ section.id }} .hero-banner__description {
      margin-bottom: {{ section.settings.description_margin_bottom_mobile }}px;
    }
  }
{%- endstyle -%}

<div class="hero-banner-{{ section.id }}">
  <div class="hero-banner__container">
    <div class="hero-banner__grid">

      {%- comment -%} Text Column {%- endcomment -%}
      <div class="hero-banner__text-col">
        {%- if section.settings.title != blank -%}
          <div class="hero-banner__title">
            {{ section.settings.title }}
          </div>
        {%- endif -%}

        {%- if section.settings.subtitle != blank -%}
          <div class="hero-banner__subtitle">
            {{ section.settings.subtitle }}
          </div>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="hero-banner__description">
            {{ section.settings.description }}
          </div>
        {%- endif -%}

        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <a
            href="{{ section.settings.button_link }}"
            class="hero-banner__button"
            {% if section.settings.button_open_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
          >
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>

      {%- comment -%} Image Column {%- endcomment -%}
      <div class="hero-banner__image-col">
        {%- if section.settings.image != blank -%}
          <div class="hero-banner__image-wrapper">
            <div class="hero-banner__image">
              {{
                section.settings.image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 600, 800, 1000, 1200',
                  sizes: '(max-width: 749px) 100vw, 50vw',
                  alt: section.settings.image.alt | escape
              }}
            </div>
          </div>
        {%- else -%}
          <div class="hero-banner__image-wrapper">
            <div class="hero-banner__image">
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Color Scheme"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "right", "label": "Text left, Image right" },
        { "value": "left",  "label": "Image left, Text right" }
      ],
      "default": "right"
    },
    {
      "type": "range",
      "id": "columns_gap",
      "label": "Gap between columns (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "columns_gap_mobile",
      "label": "Gap between columns (mobile)",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Section Padding (Desktop)"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "section_padding_horizontal",
      "label": "Padding horizontal",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Section Padding (Mobile)"
    },
    {
      "type": "range",
      "id": "section_padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "section_padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "section_padding_horizontal_mobile",
      "label": "Padding horizontal (mobile)",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Title",
      "default": "<p><strong>Turn Your Pet's Photo Into</strong></p><p><strong>A Work Of Art!</strong></p>"
    },
    {
      "type": "range",
      "id": "title_margin_bottom",
      "label": "Title margin bottom (desktop)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "title_margin_bottom_mobile",
      "label": "Title margin bottom (mobile)",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Subtitle"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "<p>One-Of-A-Kind Portraits, Apparel & Gifts</p>"
    },
    {
      "type": "range",
      "id": "subtitle_margin_bottom",
      "label": "Subtitle margin bottom (desktop)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "subtitle_margin_bottom_mobile",
      "label": "Subtitle margin bottom (mobile)",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Description"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Turn any pet photo into a <strong>One-Of-A-Kind</strong> Portrait, Apparel, Or Gift — Professionally Designed And Perfected With Unlimited Revisions</p>"
    },
    {
      "type": "range",
      "id": "description_margin_bottom",
      "label": "Description margin bottom (desktop)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "description_margin_bottom_mobile",
      "label": "Description margin bottom (mobile)",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "button_open_new_tab",
      "label": "Open link in new tab",
      "default": false
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background color",
      "default": "#C89A2A"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "button_padding_vertical",
      "label": "Button padding vertical",
      "min": 4,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_padding_horizontal",
      "label": "Button padding horizontal",
      "min": 8,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Button border radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "checkbox",
      "id": "image_border_radius",
      "label": "Enable image border radius",
      "default": true
    },
    {
      "type": "range",
      "id": "image_border_radius_px",
      "label": "Image border radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Image Decoration"
    },
    {
      "type": "select",
      "id": "image_decoration",
      "label": "Decoration type",
      "options": [
        { "value": "none",      "label": "None" },
        { "value": "rectangle", "label": "Rectangle below image" },
        { "value": "border",    "label": "Border overlay" }
      ],
      "default": "border"
    },
    {
      "type": "color",
      "id": "decoration_color",
      "label": "Decoration color",
      "default": "#C89A2A"
    },
    {
      "type": "range",
      "id": "decoration_width",
      "label": "Decoration width (rectangle width / border thickness)",
      "min": 1,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 3
    },
    {
      "type": "range",
      "id": "decoration_height",
      "label": "Rectangle height",
      "info": "Only used for Rectangle decoration type",
      "min": 4,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "decoration_border_radius",
      "label": "Decoration border radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "decoration_offset",
      "label": "Rectangle margin top / Border inset",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "border_offset",
      "label": "Border inset offset",
      "info": "Only used for Border decoration type",
      "min": -20,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 6
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}