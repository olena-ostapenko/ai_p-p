</div>

<script>
  (() => {
    function scaleHeroGallery() {
      const section = document.getElementById('shopify-section-{{ section.id }}');
      if (!section) return;
      const col = section.querySelector('.hero-banner__image-col');
      const gallery = section.querySelector('.hero-banner__gallery');
      if (!col || !gallery) return;

      if (window.innerWidth > 749) {
        gallery.style.transform = '';
        gallery.style.transformOrigin = '';
        col.style.height = '';
        return;
      }

      gallery.style.transform = '';
      const galleryW = gallery.scrollWidth;
      const colW = col.clientWidth;

      if (galleryW > colW && galleryW > 0) {
        const scale = colW / galleryW;
        gallery.style.transformOrigin = 'top left';
        gallery.style.transform = 'scale(' + scale + ')';
        col.style.height = Math.round(gallery.scrollHeight * scale) + 'px';
      }
    }

    document.addEventListener('DOMContentLoaded', scaleHeroGallery);
    window.addEventListener('resize', scaleHeroGallery);
  })();
</script>

