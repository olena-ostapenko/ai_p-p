              {%- for i in (1..2) -%}
                {%- assign cur_img = img1 -%}{%- if i == 2 -%}{%- assign cur_img = img2 -%}{%- endif -%}
                <div class="hero-gallery__item hero-gallery__item--{{ i }}">
