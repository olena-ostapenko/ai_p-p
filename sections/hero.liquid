              {%- endfor -%}
            </div>
            <div class="hero-gallery__row">
              <div class="hero-gallery__item hero-gallery__item--3">
                {%- if img3 != blank -%}{{ img3 | image_url: width: 1000 | image_tag: loading: 'lazy' }}{%- else -%}{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
              </div>
            </div>

          {%- elsif layout == '4-grid' -%}
            <div class="hero-gallery__row">
              {%- for i in (1..2) -%}
                {%- assign cur_img = img1 -%}{%- if i == 2 -%}{%- assign cur_img = img2 -%}{%- endif -%}
                <div class="hero-gallery__item hero-gallery__item--{{ i }}">
                  {%- if cur_img != blank -%}{{ cur_img | image_url: width: 600 | image_tag: loading: 'lazy' }}{%- else -%}{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
