{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.color_scheme.settings.background }};
    color: {{ section.settings.color_scheme.settings.text }};
  }

  .hero-banner-{{ section.id }} .hero-banner__container {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: {{ section.settings.section_padding_top }}px {{ section.settings.section_padding_horizontal }}px {{ section.settings.section_padding_bottom }}px;
  }

  .hero-banner-{{ section.id }} .hero-banner__grid {
    display: flex;
    flex-direction: {% if section.settings.image_position == 'left' %}row{% else %}row-reverse{% endif %};
    align-items: center;
    gap: {{ section.settings.columns_gap }}px;
  }

  .hero-banner-{{ section.id }} .hero-banner__text-col {
    flex: 1;
    min-width: 0;
  }

  .hero-banner-{{ section.id }} .hero-banner__text-col {
    flex: 0 0 {{ section.settings.col_width_text }}%;
    width: {{ section.settings.col_width_text }}%;
    min-width: 0;
  }

  {%- if section.settings.gallery_layout == '1' -%}
  /* Single image — column sized by image_width setting */
  .hero-banner-{{ section.id }} .hero-banner__image-col {
    flex: 0 0 auto;
    width: auto;
    min-width: 0;
    overflow: visible;
  }
  {%- else -%}
  /* Gallery — column sized by col_width_image % */
  .hero-banner-{{ section.id }} .hero-banner__image-col {
    flex: 0 0 {{ section.settings.col_width_image }}%;
    width: {{ section.settings.col_width_image }}%;
    min-width: 0;
  }
  {%- endif -%}

  .hero-banner-{{ section.id }} .hero-banner__title {
    margin-bottom: {{ section.settings.title_margin_bottom }}px;
    font-size: {%- if section.settings.use_hero_typography -%}{{ settings.hero_title_size_mobile }}{%- else -%}{{ settings.section_heading_size_mobile }}{%- endif -%}px;
    font-weight: {%- if section.settings.use_hero_typography -%}{{ settings.hero_title_font_weight }}{%- else -%}700{%- endif -%};
    line-height: 1.2;
    text-transform: uppercase;
    text-align: var(--section-heading-align-mobile, center);
  }

  @media screen and (min-width: 750px) {
    .hero-banner-{{ section.id }} .hero-banner__title {
      font-size: {%- if section.settings.use_hero_typography -%}{{ settings.hero_title_size_desktop }}{%- else -%}{{ settings.section_heading_size_desktop }}{%- endif -%}px;
      text-align: var(--section-heading-align-desktop, left);
    }
  }



  /* If admin selects H2 in richtext — apply section heading styles */
  .hero-banner-{{ section.id }} .hero-banner__title h2 {
    font-size: var(--section-heading-size-mobile, 26px);
    font-weight: 700;
    line-height: 1.2;
    text-align: var(--section-heading-align-mobile, center);
    margin: 0 0 var(--section-heading-margin-bottom, 12px);
    text-transform: uppercase;
  }

  @media screen and (min-width: 750px) {
    .hero-banner-{{ section.id }} .hero-banner__title h2 {
      font-size: var(--section-heading-size-desktop, 36px);
      text-align: var(--section-heading-align-desktop, left);
    }
  }

  .hero-banner-{{ section.id }} .hero-banner__subtitle {
    margin-bottom: {{ section.settings.subtitle_margin_bottom }}px;
    font-size: {%- if section.settings.use_hero_typography -%}{{ settings.hero_subtitle_size_desktop }}{%- else -%}{{ section.settings.subtitle_size }}{%- endif -%}px;
    font-weight: {%- if section.settings.use_hero_typography -%}{{ settings.hero_subtitle_font_weight }}{%- else -%}700{%- endif -%};
  }



  .hero-banner-{{ section.id }} .hero-banner__description,
  .hero-banner-{{ section.id }} .hero-banner__description p {
    margin-bottom: {{ section.settings.description_margin_bottom }}px;
    text-transform: {{ section.settings.description_text_transform }};
  }

  /* Image wrapper — border overlay */
  .hero-banner-{{ section.id }} .hero-banner__image-wrapper {
    position: relative;
    display: block;
    width: 100%;
  }

  {%- if section.settings.enable_image_border -%}
  .hero-banner-{{ section.id }} .hero-banner__image-wrapper::after {
    content: '';
    position: absolute;
    inset: -0.5rem;
    border: {{ section.settings.border_thickness }}px solid {{ section.settings.decoration_color }};
    border-radius: {{ section.settings.decoration_border_radius }}px;
    pointer-events: none;
  }
  {%- endif -%}

  .hero-banner-{{ section.id }} .hero-banner__image img {
    width: {{ section.settings.image_width }}px;
    max-width: 100%;
    height: auto;
    display: block;
    border-radius: {% if section.settings.image_border_radius %}{{ section.settings.image_border_radius_px }}px{% else %}0{% endif %};
  }
  .hero-banner-{{ section.id }} .hero-banner__image {
    border-radius: {% if section.settings.image_border_radius %}{{ section.settings.image_border_radius_px }}px{% else %}0{% endif %};
    overflow: hidden;
  }

  /* Gallery layout — flex, images keep natural size */
  {%- assign layout = section.settings.gallery_layout -%}

  .hero-banner-{{ section.id }} .hero-banner__gallery {
    display: flex;
    gap: {{ section.settings.gallery_gap }}px;
    width: fit-content;
    max-width: 100%;
    padding: {{ section.settings.border_thickness }}px;
    box-sizing: border-box;
  }

  {%- if layout == '2-vertical' -%}
    /* Stack vertically */
    .hero-banner-{{ section.id }} .hero-banner__gallery {
      flex-direction: column;
    }
  {%- elsif layout == '3-top1' -%}
    /* 1 full-width top, 2 bottom */
    .hero-banner-{{ section.id }} .hero-banner__gallery {
      flex-direction: column;
    }
    .hero-banner-{{ section.id }} .hero-gallery__row {
      display: flex;
      gap: {{ section.settings.gallery_gap }}px;
    }
  {%- elsif layout == '3-top2' -%}
    /* 2 top, 1 full-width bottom */
    .hero-banner-{{ section.id }} .hero-banner__gallery {
      flex-direction: column;
    }
    .hero-banner-{{ section.id }} .hero-gallery__row {
      display: flex;
      gap: {{ section.settings.gallery_gap }}px;
    }
  {%- elsif layout == '4-grid' -%}
    /* 2 columns, 2 rows */
    .hero-banner-{{ section.id }} .hero-banner__gallery {
      flex-direction: column;
    }
    .hero-banner-{{ section.id }} .hero-gallery__row {
      display: flex;
      gap: {{ section.settings.gallery_gap }}px;
    }
  {%- endif -%}

  {%- assign chess = section.settings.gallery_chess -%}
  {%- if chess == 'chess' -%}
    .hero-banner-{{ section.id }} .hero-gallery__item:nth-child(even) {
      margin-top: {{ section.settings.gallery_chess_offset }}px;
    }
  {%- elsif chess == 'chess-reverse' -%}
    .hero-banner-{{ section.id }} .hero-gallery__item:nth-child(odd) {
      margin-top: {{ section.settings.gallery_chess_offset }}px;
    }
  {%- endif -%}

  .hero-banner-{{ section.id }} .hero-gallery__item {
    border-radius: {% if section.settings.gallery_border_radius %}{{ section.settings.gallery_border_radius_px }}px{% else %}0{% endif %};
    position: relative;
    /* no overflow:hidden — border ::before uses negative inset and must be visible */
    flex-shrink: 0;
  }

  .hero-banner-{{ section.id }} .hero-gallery__item img,
  .hero-banner-{{ section.id }} .hero-gallery__item .placeholder-svg {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {% if section.settings.gallery_border_radius %}{{ section.settings.gallery_border_radius_px }}px{% else %}0{% endif %};
    position: relative;
    z-index: 1;
    /* clip image to border-radius */
    overflow: hidden;
  }

  /* Individual image widths */
  .hero-banner-{{ section.id }} .hero-gallery__item--1 { width: {{ section.settings.img1_width }}px; }
  .hero-banner-{{ section.id }} .hero-gallery__item--2 { width: {{ section.settings.img2_width }}px; }
  .hero-banner-{{ section.id }} .hero-gallery__item--3 { width: {{ section.settings.img3_width }}px; }
  .hero-banner-{{ section.id }} .hero-gallery__item--4 { width: {{ section.settings.img4_width }}px; }

  {%- if section.settings.enable_image_border -%}
  .hero-banner-{{ section.id }} .hero-gallery__item img {
    outline: {{ section.settings.border_thickness }}px solid {{ section.settings.decoration_color }};
    outline-offset: -1px;
  }
  {%- endif -%}

  .hero-banner-{{ section.id }} .hero-banner__button {
    display: inline-block;
    background-color: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    padding: {{ section.settings.button_padding_vertical }}px {{ section.settings.button_padding_horizontal }}px;
    border-radius: {{ section.settings.button_border_radius }}px;
    text-decoration: none;
    font-weight: 600;
    transition: opacity 0.2s ease;
  }

  .hero-banner-{{ section.id }} .hero-banner__button:hover {
    opacity: 0.85;
  }


  /* decor subtitle */
  {%- if section.settings.enable_subtitle_decor -%}
  #shopify-section-{{ section.id }} .hero-banner__subtitle {
    position: relative;
    display: inline-block;
    
  }

  #shopify-section-{{ section.id }} .hero-banner__subtitle::before {
    content: '';
    position: absolute;
    bottom: {{ section.settings.decor_line_offset_y }}px;
    left: {{ section.settings.decor_line_offset_x }}%;
    width: 100%;
    height: 20px;
    background-image: url('https://cdn.shopify.com/s/files/1/0690/5433/3063/files/hero_curve.svg?v=1777451004');
    background-repeat: no-repeat;
    background-size: 100% 100%;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .hero-banner__subtitle::after {
    content: '';
    display: inline-block;
    width: 0.75em;
    height: 0.75em;
    background-image: url('https://cdn.shopify.com/s/files/1/0690/5433/3063/files/hero_paw.svg?v=1777450948');
    background-repeat: no-repeat;
    background-size: contain;
    background-position: center;
    vertical-align: middle;
    left: {{ section.settings.decor_paw_offset_x }}px;
    position: relative;
    top: {{ section.settings.decor_paw_offset_y }}px;
  }

  {%- comment -%} Ukrainian locale overrides for desktop {%- endcomment -%}
  {%- if request.locale.iso_code == 'uk' -%}
  #shopify-section-{{ section.id }} .hero-banner__subtitle::before {
    bottom: {{ section.settings.decor_line_offset_y_uk }}px;
    left: {{ section.settings.decor_line_offset_x_uk }}%;
  }
  #shopify-section-{{ section.id }} .hero-banner__subtitle::after {
    left: {{ section.settings.decor_paw_offset_x_uk }}px;
    top: {{ section.settings.decor_paw_offset_y_uk }}px;
  }
  {%- endif -%}
  {%- endif -%}


 @media screen and (max-width: 749px) {
    /* Контейнер секції */
    .hero-banner-{{ section.id }} .hero-banner__container {
      padding-top: {{ section.settings.section_padding_top_mobile }}px;
      padding-bottom: {{ section.settings.section_padding_bottom_mobile }}px;
      padding-left: {{ section.settings.section_padding_horizontal_mobile }}px;
      padding-right: {{ section.settings.section_padding_horizontal_mobile }}px;
    }

    /* Налаштування сітки */
    .hero-banner-{{ section.id }} .hero-banner__grid {
      flex-direction: column;
      gap: {{ section.settings.columns_gap_mobile }}px;
      align-items: center; /* Центруємо колонки по горизонталі */
    }

    /* Текстова колонка */
    .hero-banner-{{ section.id }} .hero-banner__text-col {
      width: 100%;
      text-align: center;
    }

    /* Image col — full width on mobile */
    .hero-banner-{{ section.id }} .hero-banner__image-col {
      width: 100% !important;
      max-width: 100% !important;
      flex: 0 0 100% !important;
      overflow: hidden;
    }

    /* Single image */
    .hero-banner-{{ section.id }} .hero-banner__image img {
      width: 100%;
      height: auto;
      display: block;
    }

    /* Gallery — full width, rows scale proportionally */
    .hero-banner-{{ section.id }} .hero-banner__gallery {
      width: 100% !important;
      flex-direction: column;
      transform: none !important;
    }

    .hero-banner-{{ section.id }} .hero-gallery__row {
      width: 100%;
      display: flex;
      gap: {{ section.settings.gallery_gap }}px;
      align-items: flex-end;
    }

    .hero-banner-{{ section.id }} .hero-gallery__row:nth-child(2) {
      align-items: flex-start;
    }

    .hero-banner-{{ section.id }} .hero-gallery__item--1,
    .hero-banner-{{ section.id }} .hero-gallery__item--2,
    .hero-banner-{{ section.id }} .hero-gallery__item--3,
    .hero-banner-{{ section.id }} .hero-gallery__item--4 {
      flex: 1;
      width: auto !important;
      min-width: 0;
    }

    .hero-banner-{{ section.id }} .hero-gallery__item img {
      width: 100% !important;
      height: auto !important;
    }

    /* Маргінали для тексту */
    .hero-banner-{{ section.id }} .hero-banner__title {
      margin-bottom: {{ section.settings.title_margin_bottom_mobile }}px;
    }

    .hero-banner-{{ section.id }} .hero-banner__subtitle {
      margin-bottom: {{ section.settings.subtitle_margin_bottom_mobile }}px;
      font-size: {{ section.settings.subtitle_size_mobile }}px;
    }

    .hero-banner-{{ section.id }} .hero-banner__description {
      margin-bottom: {{ section.settings.description_margin_bottom_mobile }}px;
    }

    /* Декоративні елементи */
    {%- if section.settings.enable_subtitle_decor -%}
    #shopify-section-{{ section.id }} .hero-banner__subtitle::before {
      height: 12px;
      bottom: {{ section.settings.decor_line_offset_y_mobile }}px;
      left: {{ section.settings.decor_line_offset_x_mobile }}%;
    }

    #shopify-section-{{ section.id }} .hero-banner__subtitle::after {
      width: 0.55em;
      height: 0.55em;
      left: {{ section.settings.decor_paw_offset_x_mobile }}px;
      top: {{ section.settings.decor_paw_offset_y_mobile }}px;
    }

    {%- comment -%} Ukrainian locale overrides for mobile {%- endcomment -%}
    {%- if request.locale.iso_code == 'uk' -%}
    #shopify-section-{{ section.id }} .hero-banner__subtitle::before {
      bottom: {{ section.settings.decor_line_offset_y_mobile_uk }}px;
      left: {{ section.settings.decor_line_offset_x_mobile_uk }}%;
    }
    #shopify-section-{{ section.id }} .hero-banner__subtitle::after {
      left: {{ section.settings.decor_paw_offset_x_mobile_uk }}px;
      top: {{ section.settings.decor_paw_offset_y_mobile_uk }}px;
    }
    {%- endif -%}
    {%- endif -%}
  }

.hero-banner-{{ section.id }} .hero-banner__subtitle,
.hero-banner-{{ section.id }} .hero-banner__subtitle p,
.hero-banner-{{ section.id }} .hero-banner__subtitle h1,
.hero-banner-{{ section.id }} .hero-banner__subtitle h2,
.hero-banner-{{ section.id }} .hero-banner__subtitle strong {
  color: {{ section.settings.subtitle_color }};
  font-weight: {%- if section.settings.use_hero_typography -%}{{ settings.hero_subtitle_font_weight }}{%- else -%}700{%- endif -%};
}

.hero-banner-{{ section.id }} .hero-banner__title strong {
  color: {{ section.settings.decoration_color }};
}

/* Title rendered as richtext <p><strong> — match h2 styles */
.hero-banner-{{ section.id }} .hero-banner__title p,
.hero-banner-{{ section.id }} .hero-banner__title h1,
.hero-banner-{{ section.id }} .hero-banner__title h2 {
  font-size: var(--section-heading-size-mobile, 26px);
  font-weight: 800;
  line-height: 1.2;
  text-align: var(--section-heading-align-mobile, center);
  margin: 0 0 4px;
  text-transform: uppercase;
}

@media screen and (min-width: 750px) {
  .hero-banner-{{ section.id }} .hero-banner__title p,
  .hero-banner-{{ section.id }} .hero-banner__title h1,
  .hero-banner-{{ section.id }} .hero-banner__title h2 {
    font-size: var(--section-heading-size-desktop, 44px);
    text-align: var(--section-heading-align-desktop, left);
  }
}

.hero-banner-{{ section.id }} .hero-banner__title p strong,
.hero-banner-{{ section.id }} .hero-banner__title p b {
  font-weight: 800;
}

  /* Decorative elements */
  .hero-banner-{{ section.id }} {
    position: relative;
    isolation: isolate;
    /* overflow:hidden removed — was clipping image outlines/borders */
  }

  /* Clip decorative elements without affecting image borders */
  .hero-banner-{{ section.id }} .hero-banner__container {
    overflow: visible;
  }

  {%- for block in section.blocks -%}
    {%- if block.type == 'decor' -%}
      {%- assign safe_id = block.id | replace: '-', '_' -%}
      .hero-decor--{{ safe_id }} {
        position: absolute;
        left: {{ block.settings.pos_x }}%;
        top: {{ block.settings.pos_y }}%;
        width: {{ block.settings.size }}px;
        height: {{ block.settings.size }}px;
        transform: rotate({{ block.settings.rotation }}deg);
        opacity: {{ block.settings.opacity | divided_by: 100.0 }};
        pointer-events: none;
        z-index: 0;
      }
      .hero-decor--{{ safe_id }} img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        display: block;
      }
    {%- endif -%}
  {%- endfor -%}

  {%- for block in section.blocks -%}
    {%- if block.type == 'decor_large' -%}
      {%- assign safe_id = block.id | replace: '-', '_' -%}
      .hero-decor-lg--{{ safe_id }} {
        position: absolute;
        left: {{ block.settings.pos_x }}%;
        top: {{ block.settings.pos_y }}%;
        width: {{ block.settings.size }}px;
        height: {{ block.settings.size }}px;
        transform: rotate({{ block.settings.rotation }}deg);
        opacity: {{ block.settings.opacity | divided_by: 100.0 }};
        pointer-events: none;
        z-index: 0;
      }
      .hero-decor-lg--{{ safe_id }} img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        display: block;
      }
    {%- endif -%}
  {%- endfor -%}

{%- endstyle -%}

<div class="hero-banner-{{ section.id }}">

  {%- comment -%} Decorative elements {%- endcomment -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'decor' -%}
      {%- assign safe_id = block.id | replace: '-', '_' -%}
      <div class="hero-decor--{{ safe_id }}" {{ block.shopify_attributes }} aria-hidden="true">
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
        {%- endif -%}
      </div>
    {%- elsif block.type == 'decor_large' -%}
      {%- assign safe_id = block.id | replace: '-', '_' -%}
      <div class="hero-decor-lg--{{ safe_id }}" {{ block.shopify_attributes }} aria-hidden="true">
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', alt: '' }}
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- endfor -%}

  <div class="hero-banner__container" style="position:relative;z-index:2;">
    <div class="hero-banner__grid page-width">

      {%- comment -%} Text Column {%- endcomment -%}
      <div class="hero-banner__text-col">
        {%- if section.settings.title != blank -%}
          <div class="hero-banner__title">{{ section.settings.title }}</div>
        {%- endif -%}

        {%- if section.settings.subtitle != blank -%}
          <div class="hero-banner__subtitle">
            {{ section.settings.subtitle }} 
          </div>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="hero-banner__description">
            {{ section.settings.description }}
          </div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a
            href="{{ section.settings.button_link | default: '#' }}"
            class="hero-banner__button"
            {% if section.settings.button_open_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
          >
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>

      {%- comment -%} Image Column {%- endcomment -%}
      <div class="hero-banner__image-col">
        {%- liquid
          assign layout = section.settings.gallery_layout
          assign imgs = ''
          assign img1 = section.settings.image
          assign img2 = section.settings.image_2
          assign img3 = section.settings.image_3
          assign img4 = section.settings.image_4
          assign img_sizes = '(max-width: 749px) ' | append: section.settings.image_width_mobile | append: 'px, ' | append: section.settings.image_width | append: 'px'

          if layout == '1'
            assign visible_count = 1
          elsif layout == '2-vertical'
            assign visible_count = 2
          elsif layout == '3-top1' or layout == '3-top2'
            assign visible_count = 3
          elsif layout == '4-grid'
            assign visible_count = 4
          endif
        -%}

        {%- comment -%} Build images array {%- endcomment -%}
        {%- assign gallery_images = '' | split: '' -%}
        {%- if img1 != blank -%}{%- assign gallery_images = gallery_images | push: img1 -%}{%- endif -%}
        {%- if img2 != blank and visible_count >= 2 -%}{%- assign gallery_images = gallery_images | push: img2 -%}{%- endif -%}
        {%- if img3 != blank and visible_count >= 3 -%}{%- assign gallery_images = gallery_images | push: img3 -%}{%- endif -%}
        {%- if img4 != blank and visible_count >= 4 -%}{%- assign gallery_images = gallery_images | push: img4 -%}{%- endif -%}

        <div class="hero-banner__gallery">
          {%- if layout == '1' -%}
            <div class="hero-gallery__item hero-gallery__item--1">
              {%- if img1 != blank -%}
                {{ img1 | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '300, 400, 500, 600, 800, 1000, 1200', sizes: img_sizes, alt: img1.alt | escape }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>

          {%- elsif layout == '2-vertical' -%}
            {%- for i in (1..2) -%}
              {%- assign cur_img = img1 -%}{%- if i == 2 -%}{%- assign cur_img = img2 -%}{%- endif -%}
              <div class="hero-gallery__item hero-gallery__item--{{ i }}">
                {%- if cur_img != blank -%}{{ cur_img | image_url: width: 800 | image_tag: loading: 'lazy' }}{%- else -%}{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
              </div>
            {%- endfor -%}

          {%- elsif layout == '3-top1' -%}
            <div class="hero-gallery__row">
              <div class="hero-gallery__item hero-gallery__item--1">
                {%- if img1 != blank -%}{{ img1 | image_url: width: 1000 | image_tag: loading: 'lazy' }}{%- else -%}{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
              </div>
            </div>
            <div class="hero-gallery__row">
              {%- for i in (2..3) -%}
                {%- assign cur_img = img2 -%}{%- if i == 3 -%}{%- assign cur_img = img3 -%}{%- endif -%}
                <div class="hero-gallery__item hero-gallery__item--{{ i }}">
