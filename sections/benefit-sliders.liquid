{{ 'benefit-sliders.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.color_scheme.settings.background }};
    color: {{ section.settings.color_scheme.settings.text }};
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .bs-{{ section.id }} .bs-title__accent {
    color: {{ section.settings.color_scheme.settings.button }};
  }

  .bs-{{ section.id }} .bs-feature__icon-wrap {
    background-color: {{ section.settings.color_scheme.settings.button }};
  }

  .bs-{{ section.id }} .bs-slider__nav {
    color: {{ section.settings.nav_color }};
  }

  .bs-{{ section.id }} .bs-btn {
    background-color: {{ section.settings.btn_color }};
    color: {{ section.settings.btn_text_color }};
    border-radius: {{ section.settings.btn_radius }}px;
  }

  .bs-{{ section.id }} .bs-footer {
    text-align: {{ section.settings.btn_align }};
  }

  {%- for block in section.blocks -%}
    {%- if block.type == 'slider' -%}
      {%- assign safe = block.id | replace: '-', '_' -%}
      .bs-slider--{{ safe }} .bs-slider__track {
        height: {{ block.settings.slider_height }}px;
      }
      .bs-slider--{{ safe }} .bs-slider__nav {
        top: {{ block.settings.nav_offset }}%;
      }
    {%- endif -%}
  {%- endfor -%}
{%- endstyle -%}

{%- liquid
  assign layout = section.settings.layout
  assign accent_words = section.settings.title_accent_words | strip | split: ','
-%}

<div class="bs-section bs-{{ section.id }}{% if layout == 'sliders_first' %} bs--sliders-first{% endif %}">

  {%- comment -%} Header {%- endcomment -%}
  {%- if section.settings.title != blank -%}
    <div class="page-width">
      <div class="bs-header bs-header--{{ section.settings.title_align }}">
        {%- liquid
          assign plain_title = section.settings.title | replace: '</p>', '<br>' | replace: '<p>', '' | replace: '</h2>', '<br>' | replace: '<h2>', '' | replace: '</h1>', '<br>' | replace: '<h1>', '' | strip
          assign rendered_title = plain_title
          for aw in accent_words
            assign aw_trim = aw | strip
            if aw_trim != blank
              assign up   = aw_trim | upcase
              assign cap  = aw_trim | capitalize
              assign low  = aw_trim | downcase
              assign wu = '<span class="bs-title__accent">' | append: up  | append: '</span>'
              assign wc = '<span class="bs-title__accent">' | append: cap | append: '</span>'
              assign wl = '<span class="bs-title__accent">' | append: low | append: '</span>'
              assign rendered_title = rendered_title | replace: up,  wu
              assign rendered_title = rendered_title | replace: cap, wc
              assign rendered_title = rendered_title | replace: low, wl
            endif
          endfor
        -%}
        <h2 class="section-figma__heading">{{ rendered_title }}</h2>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} Two-column grid {%- endcomment -%}
  <div class="bs-grid page-width">

    {%- comment -%} Benefit column {%- endcomment -%}
    <div class="bs-col bs-col--benefit">
      {%- for block in section.blocks -%}
        {%- if block.type == 'benefit' -%}
          {%- assign icon_size = block.settings.icon_size | default: 56 -%}
          <div class="bs-feature" {{ block.shopify_attributes }}>
            {%- if block.settings.show_icon -%}
              <div class="bs-feature__icon-wrap" style="width:{{ icon_size }}px;height:{{ icon_size }}px;min-width:{{ icon_size }}px;">
                {%- if block.settings.icon != blank -%}
                  {{ block.settings.icon | image_url: width: 120 | image_tag: loading: 'lazy', alt: block.settings.title }}
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" style="width:55%;height:55%">
                    <circle cx="12" cy="12" r="10" stroke="rgb(var(--color-button-text,255,255,255))" stroke-width="2"/>
                  </svg>
                {%- endif -%}
              </div>
            {%- endif -%}
            <div class="bs-feature__body">
              {%- if block.settings.title != blank -%}
                <p class="bs-feature__title">{{ block.settings.title }}</p>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="bs-feature__desc">{{ block.settings.description }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- comment -%} Slider column {%- endcomment -%}
    <div class="bs-col bs-col--sliders">
      {%- for block in section.blocks -%}
        {%- if block.type == 'slider' -%}
          {%- assign safe = block.id | replace: '-', '_' -%}
          {%- if layout == 'sliders_first' -%}{%- assign slides_side = 'left' -%}{%- else -%}{%- assign slides_side = 'right' -%}{%- endif -%}
          <div class="bs-slider bs-slider--{{ safe }} bs-slider--overflow-{{ slides_side }}" {{ block.shopify_attributes }}>
            <button class="bs-slider__nav bs-slider__nav--prev" data-bs-prev="{{ safe }}" aria-label="Previous">
              <span class="icon">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
            </button>
            <div class="bs-slider__track" id="bs-track-{{ safe }}">
              {%- for i in (1..12) -%}
                {%- assign img_key = 'image_' | append: i -%}
                {%- assign cur_img = block.settings[img_key] -%}
                {%- if cur_img != blank -%}
                  <div class="bs-slide">
                    {{ cur_img | image_url: width: 800 | image_tag: loading: 'lazy', alt: '', class: 'bs-slide__img' }}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
            <button class="bs-slider__nav bs-slider__nav--next" data-bs-next="{{ safe }}" aria-label="Next">
              <span class="icon">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
            </button>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>

  {%- comment -%} Footer button {%- endcomment -%}
  {%- if section.settings.btn_label != blank -%}
    <div class="page-width">
      <div class="bs-footer">
        <a href="{{ section.settings.btn_link | default: '#' }}" class="bs-btn">
          {{ section.settings.btn_label }}
        </a>
      </div>
    </div>
  {%- endif -%}

</div>

<script>
  (() => {
    document.querySelectorAll('.bs-slider').forEach(slider => {
      const track = slider.querySelector('.bs-slider__track');
      if (!track) return;

      const id = track.id.replace('bs-track-', '');
      const prev = slider.querySelector('[data-bs-prev]');
      const next = slider.querySelector('[data-bs-next]');

      function getSlideW() {
        const slide = track.querySelector('.bs-slide');
        if (!slide) return 0;
        return slide.offsetWidth + parseInt(getComputedStyle(track).gap || 16);
      }

      if (prev) prev.addEventListener('click', () => track.scrollBy({ left: -getSlideW(), behavior: 'smooth' }));
      if (next) next.addEventListener('click', () => track.scrollBy({ left:  getSlideW(), behavior: 'smooth' }));

      // Apply edge blur via intersection observer
      const slides = track.querySelectorAll('.bs-slide');
      const observer = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          const isEdge = entry.intersectionRatio < 0.5;
          entry.target.classList.toggle('bs-slide--edge', isEdge);
        });
      }, { root: track, threshold: [0, 0.5, 1] });

      slides.forEach(s => observer.observe(s));
    });
  })();
</script>

