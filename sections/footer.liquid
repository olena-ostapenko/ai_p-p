{% comment %}theme-check-disable UndefinedObject{% endcomment %}
{{ 'component-list-payment.css' | asset_url | stylesheet_tag }}
{{ 'footer-custom.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .pf-footer {
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .pf-footer {
      margin-top: {{ section.settings.margin_top }}px;
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  {%- if section.settings.show_decorative_line -%}
    .pf-top {
      position: relative;
    }
    .pf-top__decorative-line {
      position: absolute;
      left: 0;
      right: 0;
      top: {{ section.settings.decorative_line_position }}px;
      height: {{ section.settings.decorative_line_thickness }}px;
      background-color: {{ section.settings.decorative_line_color }};
      pointer-events: none;
      z-index: 1;
    }
    @media screen and (max-width: 749px) {
      .pf-top__decorative-line {
        top: {{ section.settings.decorative_line_position_mobile }}px;
      }
      .pf-logo {
        position: relative;
        z-index: 2;
        margin-left: auto;
        margin-right: auto;
        text-align: center;
      }
    }
  {%- endif -%}
{%- endstyle -%}

<footer class="pf-footer">
  <div class="page-width">

    {%- comment -%} ── Top: logo + tags ── {%- endcomment -%}
    <div class="pf-top">
      <div class="pf-logo">
        <a href="{{ routes.root_url }}">
          <img src="https://cdn.shopify.com/s/files/1/0690/5433/3063/files/logo_w-green.png?v=1778226196"
               alt="{{ shop.name }}" width="280" height="auto" loading="lazy">
        </a>
      </div>
      {%- assign nav_index = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'link_list' -%}
          <div class="pf-tag-cell" data-tag-index="{{ nav_index }}">
            {%- if block.settings.tag != blank -%}
              <span class="pf-tag">
                <img src="https://cdn.shopify.com/s/files/1/0690/5433/3063/files/paw.svg?v=1776943183" alt="" width="13" height="13">
                {{ block.settings.tag }}
              </span>
            {%- endif -%}
          </div>
          {%- assign nav_index = nav_index | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if section.settings.show_decorative_line -%}
        <div class="pf-top__decorative-line" aria-hidden="true"></div>
      {%- endif -%}
    </div>

    {%- comment -%} ── Main columns ── {%- endcomment -%}
    <div class="pf-main">

      {%- comment -%} Brand column {%- endcomment -%}
      <div class="pf-brand">
        {%- if section.settings.brand_desc != blank -%}
          <p class="pf-brand__desc" {% if section.settings.brand_desc_width > 0 %}style="max-width:{{ section.settings.brand_desc_width }}px;"{% endif %}>{{ section.settings.brand_desc }}</p>
        {%- endif -%}
        <div class="pf-socials">
          {%- if settings.social_facebook_link != blank -%}
            <a href="{{ settings.social_facebook_link }}" class="pf-social" target="_blank" rel="noopener" aria-label="Facebook">
              <img src="https://cdn.shopify.com/s/files/1/0690/5433/3063/files/logos_facebook.svg?v=1778224321" alt="Facebook" width="34" height="34">
            </a>
          {%- endif -%}
          {%- if settings.social_instagram_link != blank -%}
            <a href="{{ settings.social_instagram_link }}" class="pf-social" target="_blank" rel="noopener" aria-label="Instagram">
              <img src="https://cdn.shopify.com/s/files/1/0690/5433/3063/files/skill-icons_instagram.svg?v=1778224443" alt="Instagram" width="34" height="34">
            </a>
          {%- endif -%}
          {%- if settings.social_tiktok_link != blank -%}
            <a href="{{ settings.social_tiktok_link }}" class="pf-social" target="_blank" rel="noopener" aria-label="TikTok">
              <img src="https://cdn.shopify.com/s/files/1/0690/5433/3063/files/logos_tiktok-icon.svg?v=1778224490" alt="TikTok" width="34" height="34">
            </a>
          {%- endif -%}
          {%- if settings.social_youtube_link != blank -%}
            <a href="{{ settings.social_youtube_link }}" class="pf-social" target="_blank" rel="noopener" aria-label="YouTube">
              <img src="https://cdn.shopify.com/s/files/1/0690/5433/3063/files/logos_youtube-icon.svg?v=1778224529" alt="YouTube" width="34" height="34">
            </a>
          {%- endif -%}
          {%- if settings.social_pinterest_link != blank -%}
            <a href="{{ settings.social_pinterest_link }}" class="pf-social" target="_blank" rel="noopener" aria-label="Pinterest">
              <img src="https://cdn.shopify.com/s/files/1/0690/5433/3063/files/logos_pinterest.svg?v=1778224562" alt="Pinterest" width="34" height="34">
            </a>
          {%- endif -%}
        </div >
        {% comment %} add translate button {% endcomment %}
        <div class="tran"> 
            {% if localization.available_languages.size > 1 %}
              <div class="pf-language-switcher">
                {% form 'localization' %}
                  <label class="visually-hidden" for="FooterLanguage">
                    Language
                  </label>

                  <select
                    id="FooterLanguage"
                    name="locale_code"
                    class="pf-language-select"
                    onchange="this.form.submit()"
                  >
                    {% for language in localization.available_languages %}
                      <option
                        value="{{ language.iso_code }}"
                        {% if language.iso_code == localization.language.iso_code %}
                          selected
                        {% endif %}
                      >
                        {{ language.endonym_name }}
                      </option>
                    {% endfor %}
                  </select>
                {% endform %}
              </div>
            {% endif %}
 
          {% style %}
.pf-language-switcher {
  margin-top: 20px;
  width: fit-content;
  min-width: 140px;
  display: block;
  position: relative;
  z-index: 5;
}

.pf-language-switcher form {
  display: block;
}

.pf-language-select {
  width: 100%;
  min-width: 140px;
  appearance: none;
  -webkit-appearance: none;

  background-color: transparent;
  border: 1px solid #fff;
  color: #fff;

  padding: 10px 16px;
  border-radius: 999px;

  font-size: 14px;
  line-height: 1.2;
  cursor: pointer;
}

.pf-language-select option {
  color: #000;
}
          {% endstyle %}

        </div>
      </div>

      {%- comment -%} Nav blocks {%- endcomment -%}
      {%- assign nav_index2 = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'link_list' -%}
          <div class="pf-nav" data-nav-index="{{ nav_index2 }}" style="{% if block.settings.col_width > 0 %}width:{{ block.settings.col_width }}px;flex-shrink:0;{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.tag != blank -%}
              <div class="pf-tag-cell pf-tag-cell--mobile">
                <span class="pf-tag">
                  <img src="https://cdn.shopify.com/s/files/1/0690/5433/3063/files/paw.svg?v=1776943183" alt="" width="13" height="13">
                  {{ block.settings.tag }}
                </span>
              </div>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <h3 class="pf-nav__heading">{{ block.settings.heading }}</h3>
            {%- endif -%}
            {%- if block.settings.menu != blank -%}
              <ul class="pf-nav__list">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
          {%- assign nav_index2 = nav_index2 | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}

    </div>

    {%- comment -%} ── Bottom bar ── {%- endcomment -%}
    <div class="pf-bottom">
      <div class="pf-bottom__copy">
        <small>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</small>
        {%- if section.settings.show_policy -%}
          &nbsp;&middot;&nbsp;
          {%- for policy in shop.policies -%}
            {%- if policy != blank -%}
              <small><a href="{{ policy.url }}">{{ policy.title }}</a></small>
              {%- unless forloop.last -%}&nbsp;&middot;&nbsp;{%- endunless -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
      {%- if section.settings.payment_enable -%}
        <div class="pf-payment">
          <ul class="list list-payment" role="list">
            {%- for type in shop.enabled_payment_types -%}
              <li class="list-payment__item">{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>

  </div>
</footer>

<script>
  (function() {
    function moveTags() {
      const isMobile = window.innerWidth <= 749;
      const tagCells = document.querySelectorAll('.pf-tag-cell');
      const navBlocks = document.querySelectorAll('.pf-nav[data-nav-index]');

      tagCells.forEach(cell => {
        const idx = cell.dataset.tagIndex;
        const nav = document.querySelector('.pf-nav[data-nav-index="' + idx + '"]');
        if (!nav) return;

        if (isMobile) {
          // Move tag cell inside nav as first child
          if (cell.parentNode !== nav) {
            nav.insertBefore(cell, nav.firstChild);
          }
        } else {
          // Move back to pf-top
          const pfTop = document.querySelector('.pf-top');
          const decorLine = pfTop.querySelector('.pf-top__decorative-line');
          if (cell.parentNode !== pfTop) {
            pfTop.insertBefore(cell, decorLine || null);
          }
        }
      });
    }

    moveTags();
    window.addEventListener('resize', moveTags);
  })();
</script>

{% schema %}
{
  "name": "Footer",
  "blocks": [

    {
      "type": "link_list",
      "name": "Navigation column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "default": "footer",
          "label": "Menu"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag (above heading)"
        },
        {
          "type": "range",
          "id": "col_width",
          "label": "Column width (0 = auto)",
          "min": 0, "max": 400, "step": 10, "unit": "px",
          "default": 0
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "textarea",
      "id": "brand_desc",
      "label": "Brand description",
      "default": "Turn any pet photo into a one-of-a-kind portrait, apparel, or gift — professionally designed and perfected with unlimited revisions"
    },
    {
      "type": "range",
      "id": "brand_desc_width",
      "label": "Description width (0 = auto)",
      "min": 0, "max": 500, "step": 10, "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "payment_enable",
      "default": true,
      "label": "Show payment icons"
    },
    {
      "type": "checkbox",
      "id": "show_policy",
      "default": true,
      "label": "Show policy links"
    },

    {
      "type": "header",
      "content": "Decorative line"
    },
    {
      "type": "checkbox",
      "id": "show_decorative_line",
      "default": false,
      "label": "Show decorative line"
    },
    {
      "type": "range",
      "id": "decorative_line_thickness",
      "min": 1, "max": 10, "step": 1, "unit": "px",
      "label": "Line thickness",
      "default": 1
    },
    {
      "type": "color",
      "id": "decorative_line_color",
      "label": "Line color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "decorative_line_position",
      "min": 0, "max": 200, "step": 2, "unit": "px",
      "label": "Line position from top (desktop)",
      "default": 60
    },
    {
      "type": "range",
      "id": "decorative_line_position_mobile",
      "min": 0, "max": 200, "step": 2, "unit": "px",
      "label": "Line position from top (mobile)",
      "default": 60
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0, "max": 100, "step": 4, "unit": "px",
      "label": "Margin top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 100, "step": 4, "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 100, "step": 4, "unit": "px",
      "label": "Padding bottom",
      "default": 32
    }
  ],
  "default": {
    "blocks": [
      { "type": "link_list", "settings": { "heading": "Discover" } },
      { "type": "link_list", "settings": { "heading": "Useful links" } },
      { "type": "link_list", "settings": { "heading": "Info" } }
    ]
  }
}
{% endschema %}
