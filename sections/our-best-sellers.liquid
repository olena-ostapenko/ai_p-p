{{ 'section-home.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.section_bg }};
    overflow: hidden;
  }

  .obs-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .obs-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Section-specific: nav color, stars color, CTA */
  .obs-{{ section.id }} .sh-nav { color: {{ section.settings.cta_bg }}; }
  .obs-{{ section.id }} .sh-stars { color: {{ section.settings.star_color }}; font-size: 24px; }
  .obs-{{ section.id }} .sh-card__price { margin: 5px 0; color: #000; font-size: 17px; font-weight: 700; }
  .obs-{{ section.id }} .sh-card__price .price-label { font-weight: 500; }
  .obs-{{ section.id }} .sh-card__cta {
    width: fit-content;
    background: {{ section.settings.cta_bg }};
    color: #ffffff;
    text-decoration: none;
    border-radius: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px 27px;
    font-size: 19px;
    font-weight: 700;
  }
{%- endstyle -%}

<svg width="0" height="0" style="position:absolute">
  <defs>
    <clipPath id="sh-card-shape" clipPathUnits="objectBoundingBox">
      <path d="M0.971731 0H0.028269C0.012656 0 0 0.008977 0 0.02005V0.97995C0 0.991023 0.012663 1 0.028275 1H0.740714C0.755442 1 0.767569 0.991875 0.769788 0.981551C0.791905 0.878734 0.891413 0.866917 0.968908 0.869298C0.985604 0.869812 1 0.860654 1 0.848805V0.02005C1 0.008977 0.987343 0 0.971731 0Z"/>
    </clipPath>
  </defs>
</svg>

<div class="obs-{{ section.id }}-padding obs-{{ section.id }}">
  <div class="page-width">

    <h2 class="section-figma__heading">{{ section.settings.title }}</h2>

    <div style="position: relative; display: flex; align-items: center;">
      <button class="sh-nav sh-nav--prev" type="button" data-obs-prev="{{ section.id }}" disabled>
        <span class="icon">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
      </button>

      <div class="sh-slider-wrap">
        <div class="sh-slider" id="obs-rail-{{ section.id }}">
          {%- if section.settings.collection != blank -%}
            {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
              <div class="sh-card__shadow-wrap">
              <article class="sh-card sh-card--shaped color-{{ settings.card_color_scheme }} gradient">
                <a href="{{ product.url }}" class="sh-card__image-wrap">
                  {%- if product.featured_image != blank -%}
                    {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: product.title }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag }}
                  {%- endif -%}
                </a>
                <div class="sh-card__body">
                  <div class="sh-stars">
                    {%- for i in (1..5) -%}
                      <img
                        src="https://cdn.shopify.com/s/files/1/0690/5433/3063/files/star_6f70947c-dc83-43ad-a444-913b32ad7465.svg?v=1777530521"
                        alt="star" width="20" height="20" loading="lazy"
                      >
                    {%- endfor -%}
                  </div>
                  <h3 class="sh-card__title">{{ product.title | truncate: 26 }}</h3>
                  <div class="sh-card__desc">{{ product.description }}</div>
                  <p class="sh-card__price"><span class="price-label">From</span> {{ product.price | money }}</p>
                  <a class="sh-card__cta" href="{{ product.url }}">{{ section.settings.button_label }}</a>
                </div>
              </article>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>

      <button class="sh-nav sh-nav--next" type="button" data-obs-next="{{ section.id }}">
        <span class="icon">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
      </button>
    </div>

  </div>
</div>

<script>
  (() => {
    const sectionId = {{ section.id | json }};
    const rail = document.getElementById(`obs-rail-${sectionId}`);
    const prevBtn = document.querySelector(`[data-obs-prev="${sectionId}"]`);
    const nextBtn = document.querySelector(`[data-obs-next="${sectionId}"]`);
    if (!rail || !prevBtn || !nextBtn) return;

    const updateNav = () => {
      prevBtn.disabled = rail.scrollLeft <= 5;
      nextBtn.disabled = rail.scrollLeft + rail.clientWidth >= rail.scrollWidth - 5;
    };

    const scrollSlider = (direction) => {
      const cardWidth = rail.querySelector('.sh-card').offsetWidth + 20;
      rail.scrollBy({ left: direction * cardWidth, behavior: 'smooth' });
    };

    prevBtn.addEventListener('click', () => scrollSlider(-1));
    nextBtn.addEventListener('click', () => scrollSlider(1));
    rail.addEventListener('scroll', updateNav);
    window.addEventListener('resize', updateNav);
    updateNav();
  })();
</script>

{% schema %}
{
  "name": "Our Best Sellers",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Our Best Sellers"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Create yours"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "default": "#FBFBFB"
    },
    {
      "type": "color",
      "id": "cta_bg",
      "label": "Main color",
      "default": "#F4844E"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Stars color",
      "default": "#E9A753"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8,
      "label": "Products to show"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80,
      "label": "Top padding"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80,
      "label": "Bottom padding"
    }
  ],
  "presets": [
    {
      "name": "Our Best Sellers"
    }
  ]
}
{% endschema %}
