{{ 'section-home.css' | asset_url | stylesheet_tag }}

{%- style -%}
.sh-card {
  position: relative;
  background-color: #ffffff;
  border-radius: 28px; /* Загальний радіус картки */
  clip-path: url(#paw-clip);
  transition: transform 0.3s ease;
}

.sh-card__paw {
  position: absolute;
  /* Значення bottom та right мають відповідати 
     пропорціям вирізу в SVG (приблизно 12% від ширини/висоти) */
  bottom: 2%; 
  right: 3%;
  width: 45px;
  height: 45px;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 5;
}

/* Якщо у вас є бордер, clip-path його обріже. 
   Для бордера краще використовувати drop-shadow на батьківському елементі */
.sh-grid__item {
  filter: drop-shadow(0 4px 10px rgba(0,0,0,0.05));
}



  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.color_scheme.settings.background }};
    color: {{ section.settings.color_scheme.settings.text }};
  }

  .ec-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .ec-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .ec-{{ section.id }} .sh-grid {
    --sh-columns: {{ section.settings.columns_per_row }};
  }
{%- endstyle -%}

<div class="ec-{{ section.id }}-padding ec-{{ section.id }}">
  <div class="page-width">

    {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
      <div class="sh-section__header">
        {%- if section.settings.title != blank -%}
          <h2 class="section-figma__heading">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <div class="sh-section__subtitle rte">{{ section.settings.subtitle }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="sh-grid list-unstyled" role="list">
        {%- for block in section.blocks -%}
          {%- assign collection = block.settings.collection -%}
          <li class="sh-grid__item" {{ block.shopify_attributes }}>

<svg width="0" height="0" style="position: absolute;">
  <defs>
    <clipPath id="paw-clip" clipPathUnits="objectBoundingBox">
      <!-- 
        M 0,0 - початок (верхній лівий)
        H 1 - лінія вправо
        V 0.75 - лінія вниз до початку вигину
        C 1, 0.85, 0.95, 0.88, 0.85, 0.88 - перша частина S-вигину
        H 0.8 - коротка пряма (можна прибрати для ще більшої плавності)
        C 0.72, 0.88, 0.7, 0.92, 0.7, 1 - друга частина S-вигину до самого низу
        H 0 - лінія вліво
        Z - закрити контур
      -->
      <path d="M 0,0 
               L 1,0 
               L 1,0.78 
               C 1,0.85 0.96,0.88 0.88,0.88 
               L 0.82,0.88 
               C 0.74,0.88 0.7,0.92 0.7,1 
               L 0,1 
               Z" />
    </clipPath>
  </defs>
</svg>


            <a
              class="sh-card color-{{ settings.card_color_scheme }} gradient"
              {% if collection != blank %}href="{{ collection.url }}"{% else %}href="#"{% endif %}
            >
              {%- liquid
                assign columns = section.settings.columns_per_row
                assign sizes = '(min-width: 990px) calc((100vw - 130px) / ' | append: columns | append: '), (min-width: 750px) calc((100vw - 120px) / 2), calc(50vw - 20px)'
              -%}

              {%- if collection != blank and collection.image -%}
                <span class="sh-card__image-wrap">
                  {{
                    collection.image
                    | image_url: width: 600
                    | image_tag:
                      loading: 'lazy',
                      widths: '300, 400, 500, 600',
                      sizes: sizes,
                      alt: collection.title | escape
                  }}
                </span>
              {%- elsif collection != blank and collection.products.first and collection.products.first.featured_image -%}
                <span class="sh-card__image-wrap">
                  {{
                    collection.products.first.featured_image
                    | image_url: width: 600
                    | image_tag:
                      loading: 'lazy',
                      widths: '300, 400, 500, 600',
                      sizes: sizes,
                      alt: collection.title | escape
                  }}
                </span>
              {%- else -%}
                <span class="sh-card__image-wrap">
                  {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                </span>
              {%- endif -%}

              <div class="sh-card__body">
                <h3 class="sh-card__title">
                  {%- if collection != blank -%}
                    {{ collection.title }}
                  {%- else -%}
                    {{ 'onboarding.collection_title' | t }}
                  {%- endif -%}
                </h3>
                {%- if collection != blank and collection.description != blank -%}
                  <p class="sh-card__desc">{{ collection.description | strip_html | truncatewords: 8 }}</p>
                {%- elsif collection == blank -%}
                  <p class="sh-card__desc">{{ 'onboarding.collection_description' | t }}</p>
                {%- endif -%}
              </div>

              <div class="sh-card__paw" aria-hidden="true">
                <img
                  src="https://cdn.shopify.com/s/files/1/0690/5433/3063/files/hero_paw_b7908f55-fa7a-465b-adde-ffe6d50be06d.svg?v=1777536439"
                  alt="" width="36" height="36" loading="lazy"
                >
              </div>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <div style="text-align:center; padding: 4rem 0; opacity: 0.5;">
        <p>{{ 'sections.collection_list.empty' | t }}</p>
      </div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Explore Collections",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Title",
      "default": "<p>EXPLORE OUR COLLECTIONS</p>"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "<p>Find the perfect way to turn your pet into something truly special</p>"
    },
    {
      "type": "range",
      "id": "columns_per_row",
      "label": "Collections per row",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Explore Collections",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
