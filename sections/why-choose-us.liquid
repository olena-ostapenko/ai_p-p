{{ 'why-choose-us.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.color_scheme.settings.background }};
    color: {{ section.settings.color_scheme.settings.text }};
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .wcu-{{ section.id }} .wcu-features { gap: {{ section.settings.blocks_gap }}px; }
  .wcu-{{ section.id }} .wcu-badge { background-color: {{ section.settings.badge_bg }}; }
  .wcu-{{ section.id }} .wcu-title__accent { color: {{ section.settings.color_scheme.settings.button }}; }
  .wcu-{{ section.id }} .wcu-feature__icon { background-color: {{ section.settings.color_scheme.settings.button }}; }

  /* Photo positions and sizes — desktop only */
  @media screen and (min-width: 990px) {
    {%- for block in section.blocks -%}
      {%- if block.type == 'photo' -%}
        {%- assign safe_id = block.id | replace: '-', '_' -%}
        .wcu-photo-wrap--{{ safe_id }} {
          {%- if block.settings.anchor_x == 'left' -%}
            left: {{ block.settings.pos_x }}%;
          {%- else -%}
            right: {{ block.settings.pos_x }}%;
          {%- endif -%}
          {%- if block.settings.anchor_y == 'top' -%}
            top: {{ block.settings.pos_y }}%;
          {%- else -%}
            bottom: {{ block.settings.pos_y }}%;
          {%- endif -%}
        }
        .wcu-photo-wrap--{{ safe_id }} .wcu-photo {
          width: {{ block.settings.size }}px;
          height: {{ block.settings.size }}px;
        }
      {%- endif -%}
    {%- endfor -%}
  }
{%- endstyle -%}

{%- liquid
  assign desktop_class = ''
  if section.settings.desktop_order == 'photos_right'
    assign desktop_class = 'wcu--photos-right'
  endif
  assign mobile_class = 'wcu--mobile-photos-first'
  if section.settings.mobile_order == 'text_first'
    assign mobile_class = 'wcu--mobile-text-first'
  endif
-%}

<div class="wcu-section wcu-{{ section.id }} {{ desktop_class }} {{ mobile_class }}">
  <div class="page-width">

    {%- comment -%} ── Photos column ── {%- endcomment -%}
    <div class="wcu-col-photos">
      <div class="wcu-photos">

        {%- assign mobile_idx = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'photo' -%}
            {%- assign safe_id = block.id | replace: '-', '_' -%}
            {%- if block.settings.show_on_mobile -%}
              {%- assign mobile_idx = mobile_idx | plus: 1 -%}
            {%- endif -%}
            {%- assign mobile_class = '' -%}
            {%- if block.settings.show_on_mobile -%}
              {%- assign mobile_class = 'wcu-mobile--' | append: mobile_idx -%}
            {%- endif -%}
            <div class="wcu-photo-wrap wcu-photo-wrap--{{ safe_id }} {{ mobile_class }}{% unless block.settings.show_on_mobile %} wcu-photo-wrap--hide-mobile{% endunless %}" {{ block.shopify_attributes }}>
              <div class="wcu-photo">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 646 | image_tag: loading: 'lazy', alt: '' }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>

              {%- if block.settings.badge_name != blank or block.settings.badge_review != blank -%}
                <div class="wcu-badge wcu-badge--{{ block.settings.badge_position }}">
                  {%- if block.settings.badge_avatar != blank -%}
                    <div class="wcu-badge__avatar">
                      {{ block.settings.badge_avatar | image_url: width: 72 | image_tag: loading: 'lazy', alt: block.settings.badge_name }}
                    </div>
                  {%- endif -%}
                  <div class="wcu-badge__text">
                    {%- if block.settings.badge_name != blank -%}
                      <p class="wcu-badge__name">{{ block.settings.badge_name }}</p>
                    {%- endif -%}
                    {%- if block.settings.badge_review != blank -%}
                      <p class="wcu-badge__review">{{ block.settings.badge_review }}</p>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}

      </div>
    </div>

    {%- comment -%} ── Text column ── {%- endcomment -%}
    <div class="wcu-col-text">

      {%- if section.settings.title != blank -%}
        {%- liquid
          assign title_parts = section.settings.title | split: ' '
          assign accent_word = section.settings.title_accent_word | downcase | strip
        -%}
        <h2 class="section-figma__heading">
          {%- for word in title_parts -%}
            {%- assign word_lower = word | downcase | strip -%}
            {%- if word_lower == accent_word and accent_word != blank -%}
              <span class="wcu-title__accent">{{ word }}</span>
            {%- else -%}
              {{ word }}
            {%- endif -%}
            {%- unless forloop.last %} {% endunless -%}
          {%- endfor -%}
        </h2>
      {%- endif -%}

      <div class="wcu-features">
        {%- for block in section.blocks -%}
          {%- if block.type == 'feature' -%}
            {%- assign icon_size = block.settings.icon_size | default: 56 -%}
            <div class="wcu-feature" {{ block.shopify_attributes }}>
              {%- if block.settings.show_icon -%}
                <div class="wcu-feature__icon" style="width:{{ icon_size }}px;height:{{ icon_size }}px;min-width:{{ icon_size }}px;">
                  {%- if block.settings.icon != blank -%}
                    {{ block.settings.icon | image_url: width: 120 | image_tag: loading: 'lazy', alt: block.settings.title }}
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:55%;height:55%">
                      <circle cx="12" cy="12" r="10" stroke="rgb(var(--color-button-text))" stroke-width="2"/>
                      <path d="M12 8v4l3 3" stroke="rgb(var(--color-button-text))" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                  {%- endif -%}
                </div>
              {%- endif -%}
              <div class="wcu-feature__body">
                {%- if block.settings.title != blank -%}
                  <p class="wcu-feature__title">{{ block.settings.title }}</p>
                {%- endif -%}
                {%- if block.settings.description != blank -%}
                  <p class="wcu-feature__desc">{{ block.settings.description }}</p>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Why Choose Us",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "desktop_order",
      "label": "Desktop column order",
      "options": [
        { "value": "photos_left",  "label": "Photos left, text right" },
        { "value": "photos_right", "label": "Photos right, text left" }
      ],
      "default": "photos_left"
    },
    {
      "type": "select",
      "id": "mobile_order",
      "label": "Mobile column order",
      "options": [
        { "value": "photos_first", "label": "Photos first, text below" },
        { "value": "text_first",   "label": "Text first, photos below" }
      ],
      "default": "photos_first"
    },
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "WHY SHOULD CHOOSE US"
    },
    {
      "type": "text",
      "id": "title_accent_word",
      "label": "Accent word (from title)",
      "info": "Enter one word from the title to highlight in button color",
      "default": "US"
    },
    {
      "type": "header",
      "content": "Feature blocks"
    },
    {
      "type": "range",
      "id": "blocks_gap",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Gap between feature blocks",
      "default": 24
    },
    {
      "type": "header",
      "content": "Badge style"
    },
    {
      "type": "color",
      "id": "badge_bg",
      "label": "Badge background color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 100, "step": 4, "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 100, "step": 4, "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo circle",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "header",
          "content": "Size & position"
        },
        {
          "type": "range",
          "id": "size",
          "min": 80,
          "max": 340,
          "step": 4,
          "unit": "px",
          "label": "Circle size",
          "default": 200
        },
        {
          "type": "select",
          "id": "anchor_x",
          "label": "Horizontal anchor",
          "options": [
            { "value": "left",  "label": "From left" },
            { "value": "right", "label": "From right" }
          ],
          "default": "left"
        },
        {
          "type": "range",
          "id": "pos_x",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Horizontal position",
          "default": 0
        },
        {
          "type": "select",
          "id": "anchor_y",
          "label": "Vertical anchor",
          "options": [
            { "value": "top",    "label": "From top" },
            { "value": "bottom", "label": "From bottom" }
          ],
          "default": "top"
        },
        {
          "type": "range",
          "id": "pos_y",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Vertical position",
          "default": 0
        },
        {
          "type": "header",
          "content": "Mobile"
        },
        {
          "type": "checkbox",
          "id": "show_on_mobile",
          "label": "Show on mobile",
          "default": true
        },
        {
          "type": "header",
          "content": "Review badge"
        },
        {
          "type": "image_picker",
          "id": "badge_avatar",
          "label": "Avatar"
        },
        {
          "type": "text",
          "id": "badge_name",
          "label": "Name"
        },
        {
          "type": "text",
          "id": "badge_review",
          "label": "Review text"
        },
        {
          "type": "select",
          "id": "badge_position",
          "label": "Badge position",
          "options": [
            { "value": "left",  "label": "Left" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        }
      ]
    },
    {
      "type": "feature",
      "name": "Feature block",
      "settings": [
        {
          "type": "checkbox",
          "id": "show_icon",
          "label": "Show icon circle",
          "default": true
        },
        {
          "type": "range",
          "id": "icon_size",
          "min": 32, "max": 80, "step": 4, "unit": "px",
          "label": "Icon circle size",
          "default": 56
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Describe this feature in a short sentence."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why Choose Us",
      "blocks": [
        {
          "type": "photo",
          "settings": {
            "size": 280, "anchor_x": "left", "pos_x": 4, "anchor_y": "top", "pos_y": 0
          }
        },
        {
          "type": "photo",
          "settings": {
            "size": 324, "anchor_x": "right", "pos_x": 0, "anchor_y": "top", "pos_y": 23
          }
        },
        {
          "type": "photo",
          "settings": {
            "size": 192, "anchor_x": "left", "pos_x": 33, "anchor_y": "bottom", "pos_y": 19
          }
        },
        {
          "type": "photo",
          "settings": {
            "size": 152, "anchor_x": "left", "pos_x": 62, "anchor_y": "bottom", "pos_y": 0
          }
        },
        {
          "type": "photo",
          "settings": {
            "size": 128, "anchor_x": "left", "pos_x": 64, "anchor_y": "top", "pos_y": 0
          }
        },
        {
          "type": "photo",
          "settings": {
            "size": 92, "anchor_x": "left", "pos_x": 0, "anchor_y": "top", "pos_y": 48
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Handcrafted By Real Artists",
            "description": "Every portrait is carefully created by professional artists to capture your pet's unique personality"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Unlimited Revisions",
            "description": "We work with you until you absolutely love the final result — no limits on edits"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Fast & Easy Process",
            "description": "Upload your photo, preview your artwork in 1–2 days, and approve it for production"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Premium Quality Products",
            "description": "From canvas to apparel, every item is made with high-quality materials designed to last"
          }
        }
      ]
    }
  ]
}
{% endschema %}
