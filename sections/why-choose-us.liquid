      "type": "select",
      "id": "desktop_order",
      "label": "Desktop column order",
      "options": [
        { "value": "photos_left",  "label": "Photos left, text right" },
        { "value": "photos_right", "label": "Photos right, text left" }
      ],
      "default": "photos_left"
    },
    {
      "type": "select",
      "id": "mobile_order",
