{{ 'why-choose-us.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.color_scheme.settings.background }};
    color: {{ section.settings.color_scheme.settings.text }};
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .wcu-{{ section.id }} .wcu-features {
    gap: {{ section.settings.blocks_gap }}px;
  }

  .wcu-{{ section.id }} .wcu-badge {
    background-color: {{ section.settings.badge_bg }};
  }

  /* Accent + icon colors from THIS section's color scheme */
  .wcu-{{ section.id }} .wcu-title__accent {
    color: {{ section.settings.color_scheme.settings.button }};
  }
  .wcu-{{ section.id }} .wcu-feature__icon {
    background-color: {{ section.settings.color_scheme.settings.button }};
  }
{%- endstyle -%}

{%- liquid
  assign desktop_class = ''
  if section.settings.desktop_order == 'photos_right'
    assign desktop_class = 'wcu--photos-right'
  endif

  assign mobile_class = 'wcu--mobile-photos-first'
  if section.settings.mobile_order == 'text_first'
    assign mobile_class = 'wcu--mobile-text-first'
  endif

  assign photo_1 = section.settings.photo_1
  assign photo_2 = section.settings.photo_2
  assign photo_3 = section.settings.photo_3
  assign photo_4 = section.settings.photo_4
  assign photo_5 = section.settings.photo_5
  assign photo_6 = section.settings.photo_6
-%}

<div class="wcu-section wcu-{{ section.id }} {{ desktop_class }} {{ mobile_class }}">
  <div class="page-width">

    {%- comment -%} ── Photos column ── {%- endcomment -%}
    <div class="wcu-col-photos">
      <div class="wcu-photos">


        {%- comment -%} Photo 1 — wcu-photo--323 {%- endcomment -%}
        <div class="wcu-photo-wrap wcu-photo-wrap--1">
          <div class="wcu-photo wcu-photo--323">
            {%- if photo_1 != blank -%}
              {{ photo_1 | image_url: width: 646 | image_tag: loading: 'lazy', alt: '' }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          {%- if section.settings.badge_1_name != blank or section.settings.badge_1_review != blank -%}
            <div class="wcu-badge wcu-badge--{{ section.settings.badge_1_position }}">
              {%- if section.settings.badge_1_avatar != blank -%}
                <div class="wcu-badge__avatar">
                  {{ section.settings.badge_1_avatar | image_url: width: 72 | image_tag: loading: 'lazy', alt: section.settings.badge_1_name }}
                </div>
              {%- endif -%}
              <div class="wcu-badge__text">
                {%- if section.settings.badge_1_name != blank -%}
                  <p class="wcu-badge__name">{{ section.settings.badge_1_name }}</p>
                {%- endif -%}
                {%- if section.settings.badge_1_review != blank -%}
