        {%- endif -%}

      </div>
    </div>

    {%- comment -%} ── Text column ── {%- endcomment -%}
    <div class="wcu-col-text">

      {%- if section.settings.title != blank -%}
        {%- liquid
          assign title_parts = section.settings.title | split: ' '
          assign accent_word = section.settings.title_accent_word | downcase | strip
        -%}
        <h2 class="section-figma__heading">
          {%- for word in title_parts -%}
            {%- assign word_lower = word | downcase | strip -%}
            {%- if word_lower == accent_word and accent_word != blank -%}
              <span class="wcu-title__accent">{{ word }}</span>
            {%- else -%}
              {{ word }}
            {%- endif -%}
            {%- unless forloop.last -%} {% endunless -%}
          {%- endfor -%}
        </h2>
      {%- endif -%}

      <div class="wcu-features">
        {%- for block in section.blocks -%}
          {%- assign icon_size = block.settings.icon_size | default: 56 -%}
          <div class="wcu-feature" {{ block.shopify_attributes }}>

            {%- if block.settings.show_icon -%}
              <div class="wcu-feature__icon" style="width:{{ icon_size }}px;height:{{ icon_size }}px;min-width:{{ icon_size }}px;">
                {%- if block.settings.icon != blank -%}
                  {{ block.settings.icon | image_url: width: 120 | image_tag: loading: 'lazy', alt: block.settings.title }}
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:55%;height:55%">
                    <circle cx="12" cy="12" r="10" stroke="rgb(var(--color-button-text))" stroke-width="2"/>
                    <path d="M12 8v4l3 3" stroke="rgb(var(--color-button-text))" stroke-width="2" stroke-linecap="round"/>
                  </svg>
                {%- endif -%}
              </div>
            {%- endif -%}

            <div class="wcu-feature__body">
              {%- if block.settings.title != blank -%}
                <p class="wcu-feature__title">{{ block.settings.title }}</p>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="wcu-feature__desc">{{ block.settings.description }}</p>
              {%- endif -%}
            </div>

          </div>
        {%- endfor -%}
      </div>

    </div>

