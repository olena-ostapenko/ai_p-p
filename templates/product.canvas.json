    "faq": {
      "type": "collapsible-content",
      "blocks": {
        "row-1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What if I don't like the result?",
            "icon": "question_mark",
            "row_content": "<p>We offer unlimited revisions. Our artists will work with you until you're 100% satisfied with your portrait.</p>"
          }
        },
        "row-2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How long does it take to receive my order?",
            "icon": "stopwatch",
            "row_content": "<p>Digital previews are ready in 2–3 business days. Printed canvases ship within 5–7 business days after approval.</p>"
          }
        },
        "row-3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What photo quality do you need?",
            "icon": "eye",
            "row_content": "<p>The clearer the better — but don't worry, our artists accept 98% of submitted photos. Daylight shots work best.</p>"
          }
        },
        "row-4": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Can I order multiple pets in one portrait?",
            "icon": "heart",
            "row_content": "<p>Absolutely! Choose your pet count when ordering and upload a separate photo for each pet.</p>"
          }
        },
        "row-5": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What sizes and frames are available?",
            "icon": "ruler",
            "row_content": "<p>Sizes: Digital Download, 8\"x10\", 12\"x16\", 18\"x24\", 24\"x32\". Frames: Black, Walnut, Birch, or unframed.</p>"
          }
        },
        "row-6": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Do you ship internationally?",
            "icon": "plane",
            "row_content": "<p>Yes, we ship worldwide. Free shipping on orders over $100.</p>"
          }
        }
